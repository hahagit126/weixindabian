/** pages/index/index.wxss **/

page {
  background: #FFF8F0;
}

.page {
  min-height: 100vh;
  padding-bottom: 220rpx;
  box-sizing: border-box;
  color: #3D2B1F;
}

/* =========================
   顶部
========================= */

.header {
  background: linear-gradient(
    145deg,
    #FEEDD8,
    #FDDCC5 40%,
    #F8C4A0
  );

  padding: 40rpx 40rpx 50rpx;
  border-radius: 0 0 64rpx 64rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.shop-name {
  font-size: 42rpx;
  font-weight: 900;
  color: #5C4510;
}

.merchant-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;

  padding: 12rpx 24rpx;

  background: rgba(92, 69, 16, 0.1);
  border: 2rpx solid rgba(92, 69, 16, 0.2);
  border-radius: 40rpx;

  font-size: 24rpx;
  font-weight: 700;
  color: #5C4510;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #E8705A;
}

.welcome {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.bears {
  width: 210rpx;
  height: 170rpx;

  display: flex;
  align-items: flex-end;
  justify-content: center;

  flex-shrink: 0;
}

.bear {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 105rpx;
  height: 120rpx;

  font-size: 82rpx;
}

.white-bear {
  transform: translateY(5rpx);
}

.brown-bear {
  transform: translateY(-10rpx);
}

.welcome-text {
  flex: 1;
}

.welcome-title {
  font-size: 28rpx;
  color: #5C4510;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.welcome-desc {
  font-size: 23rpx;
  color: #8B6914;
  line-height: 1.6;
  opacity: 0.75;
}


/* =========================
   DIY Banner
========================= */

.diy-banner {
  position: relative;

  margin: -28rpx 40rpx 0;

  padding: 32rpx 36rpx;

  display: flex;
  align-items: center;
  gap: 24rpx;

  border-radius: 48rpx;

  background: linear-gradient(
    135deg,
    #FF9A76,
    #FECDA6 50%,
    #F7B2A0
  );

  box-shadow: 0 12rpx 48rpx rgba(255, 154, 118, 0.25);
}

.diy-icon {
  width: 88rpx;
  height: 88rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  background: rgba(255,255,255,0.35);
  border-radius: 28rpx;

  font-size: 44rpx;
}

.diy-text {
  flex: 1;
}

.diy-title {
  font-size: 30rpx;
  color: #fff;
  font-weight: 800;
  margin-bottom: 4rpx;
}

.diy-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
}

.diy-arrow {
  width: 56rpx;
  height: 56rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  background: rgba(255,255,255,0.3);
  border-radius: 50%;

  color: #fff;
  font-size: 42rpx;
}


/* =========================
   标题
========================= */

.section-title {
  display: flex;
  align-items: center;
  gap: 16rpx;

  padding: 36rpx 40rpx 20rpx;

  font-size: 36rpx;
  font-weight: 800;
}

.section-line {
  width: 8rpx;
  height: 32rpx;

  border-radius: 8rpx;

  background: linear-gradient(
    #E8705A,
    #F2A7B3
  );
}

.menu-title {
  padding-top: 30rpx;
}


/* =========================
   分类
========================= */

.category-scroll {
  width: 100%;
  white-space: nowrap;
  box-sizing: border-box;
}

.category {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 10rpx;

  margin-left: 20rpx;
  padding: 18rpx 36rpx;

  background: #fff;

  border-radius: 40rpx;

  font-size: 26rpx;
  font-weight: 600;
  color: #7A6555;

  box-shadow: 0 4rpx 16rpx rgba(139,105,20,0.08);
}

.category:first-child {
  margin-left: 40rpx;
}

.category:last-child {
  margin-right: 40rpx;
}

.category-active {
  color: #fff;

  background: linear-gradient(
    135deg,
    #E8705A,
    #F0947F
  );

  box-shadow: 0 12rpx 40rpx rgba(232,112,90,0.2);
}


/* =========================
   菜单
========================= */

.menu-grid {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 28rpx;

  padding: 20rpx 40rpx 40rpx;
}

.menu-card {
  overflow: hidden;

  background: #fff;

  border-radius: 36rpx;

  box-shadow: 0 4rpx 16rpx rgba(139,105,20,0.08);
}

.card-image {
  position: relative;

  width: 100%;
  height: 240rpx;

  display: flex;
  align-items: center;
  justify-content: center;
}

.food-emoji {
  font-size: 88rpx;
}

.tag {
  position: absolute;

  left: 16rpx;
  top: 16rpx;

  padding: 6rpx 14rpx;

  border-radius: 20rpx;

  color: #fff;
  font-size: 19rpx;
  font-weight: 700;
}

.tag.hot {
  background: #E85D4A;
}

.tag.new {
  background: #7CB98B;
}

.tag.sweet {
  background: #F2A7B3;
}

.card-info {
  padding: 20rpx 24rpx 24rpx;
}

.food-name {
  overflow: hidden;

  margin-bottom: 6rpx;

  font-size: 28rpx;
  font-weight: 800;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.food-desc {
  overflow: hidden;

  margin-bottom: 18rpx;

  font-size: 21rpx;
  color: #B8A595;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  font-size: 32rpx;
  font-weight: 900;
  color: #E8705A;
}

.yuan {
  font-size: 22rpx;
  margin-right: 3rpx;
}

.add-btn {
  width: 60rpx;
  height: 60rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: linear-gradient(
    135deg,
    #E8705A,
    #F0947F
  );

  color: #fff;

  font-size: 38rpx;
  font-weight: 700;

  box-shadow: 0 6rpx 20rpx rgba(232,112,90,0.3);
}


/* =========================
   底部导航
========================= */

.bottom-nav {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  z-index: 100;

  height: 120rpx;

  display: flex;
  align-items: center;
  justify-content: space-around;

  padding-bottom: env(safe-area-inset-bottom);

  background: rgba(255,255,255,0.96);

  border-top: 1rpx solid rgba(139,105,20,0.08);
}

.nav-item {
  position: relative;

  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 5rpx;

  min-width: 120rpx;

  font-size: 20rpx;
  color: #B8A595;
  font-weight: 500;
}

.nav-icon {
  font-size: 42rpx;
  line-height: 42rpx;
}

.nav-active {
  color: #E8705A;
  font-weight: 700;
}

.cart-badge {
  position: absolute;

  top: -8rpx;
  right: 16rpx;

  min-width: 34rpx;
  height: 34rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0 8rpx;

  box-sizing: border-box;

  background: #E8705A;
  color: #fff;

  border-radius: 20rpx;

  font-size: 18rpx;
  font-weight: 900;
}


/* =========================
   Toast
========================= */

.toast {
  position: fixed;

  left: 50%;
  bottom: 180rpx;

  transform: translateX(-50%);

  z-index: 300;

  padding: 20rpx 32rpx;

  background: rgba(61,43,31,0.9);

  color: #fff;

  border-radius: 18rpx;

  font-size: 24rpx;

  white-space: nowrap;
}




