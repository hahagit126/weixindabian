/* pages/cart/cart.wxss */

page {
  background: #FFF8F0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(250rpx + env(safe-area-inset-bottom));
}


/* =========================
   顶部
========================= */

.header {
  position: relative;

  padding: 80rpx 40rpx 35rpx;

  background: #FFF8F0;
}

.back {
  position: absolute;

  left: 35rpx;
  top: 82rpx;

  width: 64rpx;
  height: 64rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #fff;

  color: #8B6950;

  font-size: 38rpx;
}

.title {
  margin-left: 75rpx;

  font-size: 42rpx;

  font-weight: 800;

  color: #6B4F3A;
}

.subtitle {
  margin-left: 78rpx;
  margin-top: 8rpx;

  font-size: 22rpx;

  color: #A89584;
}


/* =========================
   空购物车
========================= */

.empty-cart {
  margin: 100rpx 35rpx;

  padding: 70rpx 30rpx;

  text-align: center;

  background: #fff;

  border-radius: 28rpx;

  box-shadow: 0 8rpx 30rpx rgba(110,80,50,0.06);
}

.empty-icon {
  font-size: 100rpx;
}

.empty-title {
  margin-top: 25rpx;

  font-size: 32rpx;

  font-weight: 700;

  color: #6B4F3A;
}

.empty-desc {
  margin-top: 12rpx;

  font-size: 23rpx;

  color: #A89584;
}

.go-shopping {
  width: 260rpx;

  margin: 35rpx auto 0;

  padding: 20rpx 0;

  background: #E8705A;

  color: white;

  border-radius: 40rpx;

  font-size: 26rpx;

  font-weight: 700;
}


/* =========================
   商品列表
========================= */

.cart-content {
  padding: 0 30rpx;
}

.cart-card {
  position: relative;

  display: flex;
  align-items: center;

  margin-bottom: 22rpx;
  padding: 25rpx;

  background: #fff;

  border-radius: 25rpx;

  box-shadow: 0 6rpx 25rpx rgba(110,80,50,0.06);
}


/* 选择 */

.checkbox {
  flex-shrink: 0;

  width: 38rpx;
  height: 38rpx;

  margin-right: 18rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 2rpx solid #D8C8BA;

  border-radius: 50%;

  box-sizing: border-box;

  color: white;

  font-size: 24rpx;

  font-weight: 700;
}

.checkbox-active {
  background: #E8705A;
  border-color: #E8705A;
}


/* 商品图片 */

.product-image {
  flex-shrink: 0;

  width: 125rpx;
  height: 125rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 22rpx;

  font-size: 58rpx;
}


/* 商品信息 */

.product-info {
  flex: 1;

  min-width: 0;

  margin-left: 22rpx;

  padding-right: 35rpx;
}

.product-name {
  font-size: 29rpx;

  font-weight: 700;

  color: #604735;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-desc {
  margin-top: 8rpx;

  font-size: 20rpx;

  color: #A89584;

  line-height: 30rpx;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: 15rpx;
}

.product-price {
  color: #E8705A;

  font-size: 28rpx;

  font-weight: 800;
}


/* 数量 */

.quantity-box {
  display: flex;
  align-items: center;

  border: 1rpx solid #E9DED4;

  border-radius: 12rpx;

  overflow: hidden;
}

.quantity-btn {
  width: 48rpx;
  height: 45rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #FFF8F0;

  color: #8B6950;

  font-size: 28rpx;
}

.quantity {
  width: 48rpx;
  height: 45rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 22rpx;

  color: #604735;

  background: white;
}


/* 删除 */

.delete-btn {
  position: absolute;

  right: 18rpx;
  top: 12rpx;

  width: 40rpx;
  height: 40rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #C6B4A4;

  font-size: 32rpx;
}


/* =========================
   结算
========================= */

.checkout-card {
  position: fixed;

  left: 0;
  right: 0;

  bottom: calc(120rpx + env(safe-area-inset-bottom));

  z-index: 90;

  min-height: 110rpx;

  padding: 15rpx 30rpx;

  box-sizing: border-box;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background: rgba(255,255,255,0.97);

  border-top: 1rpx solid rgba(139,105,20,0.08);
}

.select-all {
  display: flex;
  align-items: center;

  color: #806A59;

  font-size: 23rpx;
}

.all-checkbox {
  margin-right: 10rpx;
}

.total-area {
  display: flex;
  align-items: center;
}

.total-label {
  margin-right: 8rpx;

  font-size: 23rpx;

  color: #806A59;
}

.total-price {
  margin-right: 18rpx;

  color: #E8705A;

  font-size: 34rpx;

  font-weight: 900;
}

.checkout-btn {
  width: 170rpx;

  padding: 20rpx 0;

  text-align: center;

  background: #E8705A;

  color: white;

  border-radius: 35rpx;

  font-size: 25rpx;

  font-weight: 700;

  box-shadow: 0 6rpx 18rpx rgba(232,112,90,0.25);
}


/* =========================
   底部导航
========================= */

.bottom-nav {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  z-index: 100;

  height: calc(120rpx + env(safe-area-inset-bottom));

  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;

  display: flex;
  align-items: center;
  justify-content: space-around;

  padding-bottom: env(safe-area-inset-bottom);

  background: rgba(255,255,255,0.96);

  border-top: 1rpx solid rgba(139,105,20,0.08);
}

.nav-item {
  position: relative;

  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 5rpx;

  min-width: 120rpx;

  font-size: 20rpx;

  color: #B8A595;

  font-weight: 500;
}

.nav-icon {
  font-size: 42rpx;
  line-height: 42rpx;
}

.nav-active {
  color: #E8705A;
  font-weight: 700;
}

.cart-badge {
  position: absolute;

  top: -8rpx;
  right: 16rpx;

  min-width: 34rpx;
  height: 34rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0 8rpx;

  box-sizing: border-box;

  background: #E8705A;

  color: #fff;

  border-radius: 20rpx;

  font-size: 18rpx;

  font-weight: 900;
}