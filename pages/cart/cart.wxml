<!-- pages/cart/cart.wxml -->

<view class="page">

<!-- 顶部 -->
<view class="header">

  <view class="back" bindtap="goBack">
    ←
  </view>

  <view class="title">
    🛒 我的购物车
  </view>

  <view class="subtitle">
    把喜欢的美味带回家~
  </view>

</view>


<!-- 空购物车 -->
<view
  wx:if="{{isEmpty}}"
  class="empty-cart"
>

  <view class="empty-icon">
    🛒
  </view>

  <view class="empty-title">
    购物车还是空的
  </view>

  <view class="empty-desc">
    去挑选一些喜欢的美味吧~
  </view>

  <view
    class="go-shopping"
    bindtap="goHome"
  >
    去逛逛
  </view>

</view>


<!-- 商品列表 -->
<view
  wx:else
  class="cart-content"
>

  <view
    wx:for="{{cartList}}"
    wx:key="cartId"
    class="cart-card"
  >

    <!-- 选择 -->
    <view
      class="checkbox {{item.selected ? 'checkbox-active' : ''}}"
      data-id="{{item.cartId}}"
      bindtap="toggleSelect"
    >
      {{item.selected ? '✓' : ''}}
    </view>


    <!-- 商品图 -->
    <view
      class="product-image"
      style="background: {{item.background}};"
    >
      {{item.emoji}}
    </view>


    <!-- 商品信息 -->
    <view class="product-info">

      <view class="product-name">
        {{item.name}}
      </view>

      <view class="product-desc">
        {{item.desc}}
      </view>

      <view class="product-bottom">

        <view class="product-price">
          ¥{{item.price}}
        </view>


        <view class="quantity-box">

          <view
            class="quantity-btn"
            data-id="{{item.cartId}}"
            bindtap="decrease"
          >
            −
          </view>

          <view class="quantity">
            {{item.quantity}}
          </view>

          <view
            class="quantity-btn"
            data-id="{{item.cartId}}"
            bindtap="increase"
          >
            +
          </view>

        </view>

      </view>

    </view>


    <!-- 删除 -->
    <view
      class="delete-btn"
      data-id="{{item.cartId}}"
      bindtap="removeItem"
    >
      ×
    </view>

  </view>


  <!-- 结算区域 -->
  <view class="checkout-card">

    <view class="select-all">

      <view
        class="checkbox all-checkbox {{allSelected ? 'checkbox-active' : ''}}"
        bindtap="toggleAll"
      >
        {{allSelected ? '✓' : ''}}
      </view>

      <text>全选</text>

    </view>


    <view class="total-area">

      <view class="total-label">
        合计
      </view>

      <view class="total-price">
        ¥{{totalPrice}}
      </view>

      <view
        class="checkout-btn"
        bindtap="checkout"
      >
        去结算
      </view>

    </view>

  </view>

</view>


<!-- 底部导航 -->
<view class="bottom-nav">

  <view
    class="nav-item"
    bindtap="goHome"
  >
    <text class="nav-icon">⌂</text>
    <text>首页</text>
  </view>


  <view
    class="nav-item"
    bindtap="goDIY"
  >
    <text class="nav-icon">◇</text>
    <text>DIY</text>
  </view>


  <view
    class="nav-item nav-active cart-nav"
    bindtap="goCart"
  >
    <text class="nav-icon">🛒</text>
    <text>购物车</text>

    <view
      wx:if="{{cartCount > 0}}"
      class="cart-badge"
    >
      {{cartCount}}
    </view>

  </view>


  <view
    class="nav-item"
    bindtap="goOrders"
  >
    <text class="nav-icon">▤</text>
    <text>订单</text>
  </view>

</view>

</view>