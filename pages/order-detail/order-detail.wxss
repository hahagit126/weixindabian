/* pages/order-detail/order-detail.wxss */

page {
  background: #fff8f0;
}


.page {
  min-height: 100vh;

  box-sizing: border-box;

  padding-bottom: 50rpx;

  background: #fff8f0;
}


/* ========================= */
/* 顶部 */
/* ========================= */

.header {

  height: 100rpx;

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 0 30rpx;

  box-sizing: border-box;

  background: #fff8f0;
}


.back {

  width: 70rpx;

  height: 70rpx;

  display: flex;

  align-items: center;

  justify-content: flex-start;

  font-size: 60rpx;

  color: #6b4f3a;

  line-height: 70rpx;
}


.header-title {

  font-size: 36rpx;

  font-weight: bold;

  color: #6b4f3a;
}


.header-placeholder {

  width: 70rpx;
}


/* ========================= */
/* 状态 */
/* ========================= */

.status-card {

  margin: 20rpx 30rpx;

  padding: 30rpx;

  background: #ffffff;

  border-radius: 24rpx;

  display: flex;

  align-items: center;

  box-sizing: border-box;

  box-shadow:
    0 6rpx 20rpx
    rgba(107, 79, 58, 0.06);
}


.status-icon {

  width: 76rpx;

  height: 76rpx;

  border-radius: 50%;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #6b4f3a;

  color: #ffffff;

  font-size: 40rpx;

  font-weight: bold;
}


.status-info {

  margin-left: 22rpx;
}


.status-title {

  font-size: 32rpx;

  font-weight: bold;

  color: #604735;
}


.status-time {

  margin-top: 8rpx;

  font-size: 23rpx;

  color: #a28c7a;
}


/* ========================= */
/* 卡片 */
/* ========================= */

.card {

  margin: 20rpx 30rpx;

  padding: 30rpx;

  background: #ffffff;

  border-radius: 24rpx;

  box-sizing: border-box;

  box-shadow:
    0 6rpx 20rpx
    rgba(107, 79, 58, 0.06);
}


.card-title {

  padding-bottom: 22rpx;

  border-bottom: 1rpx solid #f3ebe4;

  font-size: 30rpx;

  font-weight: bold;

  color: #604735;
}


/* ========================= */
/* 信息 */
/* ========================= */

.info-row {

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 18rpx 0;

  font-size: 26rpx;
}


.info-label {

  color: #998273;

  flex-shrink: 0;
}


.info-value {

  margin-left: 30rpx;

  text-align: right;

  color: #604735;
}


.order-number {

  max-width: 450rpx;

  overflow: hidden;

  white-space: nowrap;

  text-overflow: ellipsis;
}


/* ========================= */
/* 商品 */
/* ========================= */

.product-item {

  display: flex;

  align-items: center;

  padding: 25rpx 0;

  border-bottom: 1rpx solid #f3ebe4;
}


.product-item:last-child {

  border-bottom: none;

  padding-bottom: 0;
}


.product-icon {

  width: 90rpx;

  height: 90rpx;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #fff7ed;

  border-radius: 18rpx;

  font-size: 48rpx;
}


.product-info {

  flex: 1;

  min-width: 0;

  margin-left: 20rpx;
}


.product-name {

  font-size: 28rpx;

  font-weight: bold;

  color: #604735;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}


.product-desc {

  margin-top: 7rpx;

  font-size: 22rpx;

  color: #a28c7a;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}


.product-price {

  display: flex;

  align-items: center;

  margin-top: 10rpx;

  font-size: 24rpx;

  color: #b66a45;
}


.product-quantity {

  margin-left: 18rpx;

  color: #998273;
}


.product-subtotal {

  margin-left: 15rpx;

  font-size: 27rpx;

  font-weight: bold;

  color: #604735;

  flex-shrink: 0;
}


/* ========================= */
/* 金额 */
/* ========================= */

.price-row {

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 15rpx 0;

  font-size: 27rpx;

  color: #806958;
}


.divider {

  height: 1rpx;

  margin: 18rpx 0;

  background: #f3ebe4;
}


.total-row {

  display: flex;

  align-items: center;

  justify-content: space-between;

  font-size: 30rpx;

  font-weight: bold;

  color: #604735;
}


.total-price {

  font-size: 38rpx;

  color: #b66a45;
}


/* ========================= */
/* 再来一单 */
/* ========================= */

.again-button {

  margin: 30rpx;

  height: 86rpx;

  border-radius: 45rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #6b4f3a;

  color: #ffffff;

  font-size: 29rpx;

  font-weight: bold;

  box-sizing: border-box;
}


/* ========================= */
/* 空状态 */
/* ========================= */

.empty {

  min-height: 70vh;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;
}


.empty-svg {

  width: 200rpx;

  height: 200rpx;

  margin-bottom: 20rpx;
}


.empty-title {

  font-size: 32rpx;

  font-weight: bold;

  color: #604735;
}


.empty-desc {

  margin-top: 12rpx;

  font-size: 24rpx;

  color: #a28c7a;
}