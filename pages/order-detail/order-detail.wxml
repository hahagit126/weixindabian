<!-- pages/order-detail/order-detail.wxml -->

<view class="page">

<!-- 顶部 -->
<view class="header">

  <view
    class="back"
    bindtap="goBack"
  >
    ‹
  </view>

  <view class="header-title">
    订单详情
  </view>

  <view class="header-placeholder"></view>

</view>


<!-- 订单不存在 -->
<view
  wx:if="{{!order}}"
  class="empty"
>

  <image
    class="empty-svg"
    src="/pages/order/order.svg"
    mode="aspectFit"
  />

  <view class="empty-title">
    订单不存在
  </view>

  <view class="empty-desc">
    请返回订单记录查看
  </view>

</view>


<!-- 订单详情 -->
<block wx:if="{{order}}">


  <!-- 订单状态 -->
  <view class="status-card">

    <view class="status-icon">
      ✓
    </view>

    <view class="status-info">

      <view class="status-title">
        {{order.status}}
      </view>

      <view class="status-time">
        {{order.time}}
      </view>

    </view>

  </view>


  <!-- 配送信息 -->
  <view class="card">

    <view class="card-title">
      配送信息
    </view>


    <view class="info-row">

      <text class="info-label">
        配送方式
      </text>

      <text class="info-value">
        {{order.deliveryType}}
      </text>

    </view>


    <view class="info-row">

      <text class="info-label">
        配送信息
      </text>

      <text class="info-value">
        {{order.deliveryInfo}}
      </text>

    </view>

  </view>


  <!-- 商品清单 -->
  <view class="card">

    <view class="card-title">
      商品清单
    </view>


    <view
      class="product-item"
      wx:for="{{order.items}}"
      wx:key="cartId"
    >

      <!-- 商品图标 -->
      <view class="product-icon">

        <text>
          {{item.emoji}}
        </text>

      </view>


      <!-- 商品信息 -->
      <view class="product-info">

        <view class="product-name">
          {{item.name}}
        </view>

        <view class="product-desc">
          {{item.desc}}
        </view>

        <view class="product-price">

          <text>
            ¥{{item.price}}
          </text>

          <text class="product-quantity">
            × {{item.quantity}}
          </text>

        </view>

      </view>


      <!-- 小计 -->
      <view class="product-subtotal">
        ¥{{item.subtotal}}
      </view>

    </view>

  </view>


  <!-- 金额明细 -->
  <view class="card">

    <view class="card-title">
      金额明细
    </view>


    <view class="price-row">

      <text>
        商品小计
      </text>

      <text>
        ¥{{order.totalPrice}}
      </text>

    </view>


    <view class="price-row">

      <text>
        配送费
      </text>

      <text>
        {{order.deliveryFee == '0.00'
          ? '免配送费'
          : '¥' + order.deliveryFee}}
      </text>

    </view>


    <view class="divider"></view>


    <view class="total-row">

      <text>
        实付金额
      </text>

      <text class="total-price">
        ¥{{order.finalPrice}}
      </text>

    </view>

  </view>


  <!-- 订单信息 -->
  <view class="card">

    <view class="card-title">
      订单信息
    </view>


    <view class="info-row">

      <text class="info-label">
        订单号
      </text>

      <text class="info-value order-number">
        {{order.id}}
      </text>

    </view>


    <view class="info-row">

      <text class="info-label">
        下单时间
      </text>

      <text class="info-value">
        {{order.time}}
      </text>

    </view>

  </view>


  <!-- 再来一单 -->
  <view
    class="again-button"
    bindtap="buyAgain"
  >
    再来一单
  </view>


</block>

</view>