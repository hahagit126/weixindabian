
<!-- pages/admin-product/admin-product.wxml -->

<view class="page">

  <!-- 顶部 -->
  <view class="header">

    <view
      class="back"
      bindtap="goBack"
    >
      ←
    </view>

    <view class="header-content">

      <view class="title">
        🛍️ 商品管理
      </view>

      <view class="subtitle">
        管理店铺商品 · 上架 / 下架 / 编辑
      </view>

    </view>

  </view>


  <!-- 新增商品 -->
  <view
    class="add-card"
    bindtap="goAdd"
  >

    <view class="add-icon">
      ＋
    </view>

    <view class="add-info">

      <view class="add-title">
        新增商品
      </view>

      <view class="add-desc">
        创建一个新的店铺商品
      </view>

    </view>

    <view class="add-arrow">
      ›
    </view>

  </view>


  <!-- 商品列表标题 -->
  <view class="section-head">

    <view class="section-line"></view>

    <view class="section-title">
      店铺商品
    </view>

    <view class="section-count">
      {{products.length}} 件
    </view>

  </view>


  <!-- 商品列表 -->
  <view
    wx:if="{{products.length > 0}}"
    class="product-list"
  >

    <view
      wx:for="{{products}}"
      wx:key="id"
      class="product-card {{item.deleted ? 'product-deleted' : ''}}"
    >

      <!-- 左侧商品图标 -->
      <view class="product-image">

        <text class="product-emoji">
          {{item.emoji}}
        </text>

      </view>


      <!-- 商品信息 -->
      <view class="product-info">

        <view class="product-name-row">

          <view class="product-name">
            {{item.name}}
          </view>

          <view
            wx:if="{{item.deleted}}"
            class="deleted-tag"
          >
            已删除
          </view>

          <view
            wx:elif="{{item.onSale === false}}"
            class="offsale-tag"
          >
            已下架
          </view>

          <view
            wx:else
            class="onsale-tag"
          >
            在售
          </view>

        </view>


        <view class="product-desc">
          {{item.desc}}
        </view>


        <view class="product-meta">

          <view class="price">
            <text class="price-symbol">¥</text>{{item.price}}
          </view>

          <view class="product-id">
            ID {{item.id}}
          </view>

        </view>


        <!-- 操作按钮 -->
        <view class="product-actions">

          <view
            class="action edit-action"
            data-id="{{item.id}}"
            catchtap="goEdit"
          >
            编辑
          </view>


          <view
            wx:if="{{!item.deleted}}"
            class="action sale-action"
            data-id="{{item.id}}"
            catchtap="toggleSale"
          >
            {{item.onSale === false ? '上架' : '下架'}}
          </view>


          <view
            wx:if="{{!item.deleted}}"
            class="action delete-action"
            data-id="{{item.id}}"
            catchtap="deleteProduct"
          >
            删除
          </view>


          <view
            wx:if="{{item.deleted}}"
            class="action restore-action"
            data-id="{{item.id}}"
            catchtap="restoreProduct"
          >
            恢复
          </view>

        </view>

      </view>

    </view>

  </view>


  <!-- 空状态 -->
  <view
    wx:else
    class="empty"
  >

    <view class="empty-icon">
      🛍️
    </view>

    <view class="empty-title">
      暂无商品
    </view>

    <view class="empty-desc">
      点击上方“新增商品”开始添加
    </view>

  </view>

</view>

