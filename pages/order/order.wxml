<!-- pages/order/order.wxml -->

<view class="page">

<!-- 顶部 -->
<view class="header">

  <view class="header-top">

    <view class="header-left">
      <view class="header-title">
        📋 我的订单
      </view>

      <view class="header-desc">
        查看你的每一笔订单
      </view>
    </view>

  </view>

</view>


<!-- 订单列表 -->
<view class="order-section">

  <!-- 有订单 -->
  <view
    wx:if="{{orders.length > 0}}"
    class="order-list"
  >

    <view
      wx:for="{{orders}}"
      wx:key="id"
      class="order-card card-color-{{index}}"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >

      <!-- ===================== -->
      <!-- 订单顶部 -->
      <!-- ===================== -->

      <view class="order-header">

        <view class="order-header-left">

          <view class="order-label">
            订单编号
          </view>

          <view class="order-id">
            {{item.id}}
          </view>

        </view>


        <view
          class="order-status
          {{item.status === 'pending' ? 'status-pending' : ''}}
          {{item.status === 'making' ? 'status-making' : ''}}
          {{item.status === 'ready' ? 'status-ready' : ''}}
          {{item.status === 'delivering' ? 'status-delivering' : ''}}
          {{item.status === 'completed' || item.status === '已完成' ? 'status-completed' : ''}}
          {{item.status === 'cancelled' ? 'status-cancelled' : ''}}"
        >
          {{item.statusText || item.status}}
        </view>

      </view>


      <!-- 分割线 -->
      <view class="divider"></view>


      <!-- ===================== -->
      <!-- 商品区域 -->
      <!-- ===================== -->

      <view class="goods-section">

        <view class="goods-title">
          🛍️ 商品明细
        </view>


        <view
          wx:for="{{item.items}}"
          wx:for-item="goods"
          wx:for-index="goodsIndex"
          wx:key="cartId"
          class="goods-item"
        >

          <!-- 商品图标 -->
          <view class="goods-icon">
            {{goods.emoji || '🧸'}}
          </view>


          <!-- 商品信息 -->
          <view class="goods-info">

            <view class="goods-name">
              {{goods.name}}
            </view>

            <view class="goods-desc">
              {{goods.desc}}
            </view>

          </view>


          <!-- 数量 -->
          <view class="goods-quantity">
            ×{{goods.quantity}}
          </view>


          <!-- 小计 -->
          <view class="goods-price">
            ¥{{goods.subtotal}}
          </view>

        </view>

      </view>


      <!-- ===================== -->
      <!-- 配送信息 -->
      <!-- ===================== -->

      <view class="delivery-box">

        <view class="delivery-row">

          <view class="delivery-label">
            配送方式
          </view>

          <view class="delivery-value">
            {{item.deliveryType || '配送'}}
          </view>

        </view>


        <view class="delivery-row">

          <view class="delivery-label">
            下单时间
          </view>

          <view class="delivery-value">
            {{item.time}}
          </view>

        </view>

      </view>


      <!-- ===================== -->
      <!-- 金额区域 -->
      <!-- ===================== -->

      <view class="price-section">

        <view class="price-left">

          <view class="total-count">
            共 {{item.totalCount}} 件商品
          </view>

          <view class="total-label">
            实付金额
          </view>

        </view>


        <view class="total-price">
          <text class="price-symbol">¥</text>{{item.finalPrice}}
        </view>

      </view>


      <!-- ===================== -->
      <!-- 查看详情 -->
      <!-- ===================== -->

      <view class="detail-tip">
        查看订单详情 ›
      </view>

    </view>

  </view>


  <!-- ===================== -->
  <!-- 没有订单 -->
  <!-- ===================== -->

  <view
    wx:else
    class="empty"
  >

    <view class="empty-icon">
      🧸
    </view>

    <view class="empty-title">
      还没有订单
    </view>

    <view class="empty-desc">
      去布布小铺挑选一些喜欢的美味吧~
    </view>

    <view
      class="empty-button"
      bindtap="goHome"
    >
      去逛逛
    </view>

  </view>

</view>


<!-- ===================== -->
<!-- 底部导航 -->
<!-- ===================== -->

<view class="bottom-nav">

  <!-- 首页 -->
  <view
    class="nav-item"
    bindtap="goHome"
  >

    <text class="nav-icon">
      ⌂
    </text>

    <text class="nav-text">
      首页
    </text>

  </view>


  <!-- DIY -->
  <view
    class="nav-item"
    bindtap="goDIY"
  >

    <text class="nav-icon">
      ◇
    </text>

    <text class="nav-text">
      DIY
    </text>

  </view>


  <!-- 购物车 -->
  <view
    class="nav-item cart-nav"
    bindtap="goCart"
  >

    <text class="nav-icon">
      🛒
    </text>

    <text class="nav-text">
      购物车
    </text>

    <view
      wx:if="{{cartCount > 0}}"
      class="cart-badge"
    >
      {{cartCount}}
    </view>

  </view>


  <!-- 订单 -->
  <view
    class="nav-item nav-active"
    bindtap="goOrders"
  >

    <text class="nav-icon">
      ▤
    </text>

    <text class="nav-text">
      订单
    </text>

  </view>

</view>

</view>